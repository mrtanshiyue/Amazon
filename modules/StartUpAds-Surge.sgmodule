# ===== 应用增强 4. 各种流媒体字幕翻译 =====
# source: https://raw.githubusercontent.com/Neurogram-R/Quantumult-X/main/snippet/Dualsub.snippet
Dualsub_js_1 = type=http-response,pattern=^http.+(media.(dss|star)ott|manifests.v2.api.hbo|hbomaxcdn|nflxvideo|cbs(aa|i)video|cloudfront|akamaihd|avi-cdn|huluim|youtube).(com|net)\/(.+\.vtt($|\?m=\d+)|.+-all-.+\.m3u8.*|hls\.m3u8.+|\?o=\d+&v=\d+&e=.+|\w+\/2\$.+\/[a-zA-Z0-9-]+\.m3u8|api\/timedtext.+),script-path=https://raw.githubusercontent.com/Neurogram-R/Quantumult-X/main/Dualsub.js,requires-body=true
Dualsub_js_2 = type=http-response,pattern=^http.+(setting|general).(media.dssott|hbomaxcdn|nflxvideo|youtube|cbsivideo|cloudfront|huluim).(com|net)\/\?action=(g|s)et,script-path=https://raw.githubusercontent.com/Neurogram-R/Quantumult-X/main/Dualsub.js,requires-body=true

