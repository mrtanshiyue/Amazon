{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amazon-keyword-manager",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ACCESS_REQUIRED": "true"
  },
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "amazon-keyword-manager-storage"
    }
  ]
}
